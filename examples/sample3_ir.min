// Sample 3: Mini-Language Program for Semantic Analysis & IR Generation (Phase 3)
// Features recursion, arithmetic, loops, comparisons, and function calls

int globalMultiplier = 2;

int power(int base, int exp) {
    int result = 1;
    int i = 0;

    for (i = 0; i < exp; i = i + 1) {
        result = result * base;
    }

    return result;
}

int compute(int x, int y) {
    int ans = 0;

    if (x > y) {
        ans = power(x, 2) + y;
    } else {
        ans = power(y, 2) - x;
    }

    ans = ans * globalMultiplier;
    return ans;
}

void main() {
    int a = 3;
    int b = 4;
    int finalResult = 0;

    print("Computing power-based values...");
    finalResult = compute(a, b);

    print("Result:");
    print(finalResult);

    while (finalResult > 0) {
        finalResult = finalResult - 10;
        if (finalResult == 10) {
            break;
        }
    }

    print("Done.");
}
