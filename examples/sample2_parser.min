// Sample 2: Mini-Language Program for Parser Validation (Phase 2)
// Demonstrates functions, nested blocks, control flow, loops, and expressions

int globalCount = 0;

int calculate(int base, int multiplier) {
    int total = 0;
    int i = 0;

    for (i = 0; i < multiplier; i = i + 1) {
        if (i % 2 == 0) {
            total = total + base;
        } else {
            total = total + (base * 2);
        }
    }

    return total;
}

void main() {
    int x = 10;
    int y = 5;
    int res = 0;

    print("Starting computation...");
    res = calculate(x, y);

    if (res > 50 && res < 500) {
        print("Result in valid range:");
        print(res);
    } else {
        print("Result out of bounds!");
    }

    while (res > 0) {
        res = res - 10;
        if (res == 20) {
            break;
        }
    }

    print("Done.");
}
