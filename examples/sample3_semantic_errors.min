// Sample with intentional semantic errors to test diagnostic reporting
int count = 10;
int count = 20; // Redeclaration in same scope

int add(int a, int b) {
    return a + b;
}

void main() {
    int x = 5;
    x = "hello"; // Type mismatch: assigning string to int

